CREATE PROCEDURE CreateEstoque_procedure
@Id_Produto INT,
@Id_Armazem INT,
@Quantidade DECIMAL(18,4),
@Lote VARCHAR(50) = NULL,
@Data_Validade DATE = NULL
AS
BEGIN
begin try 
IF @Id_Produto IS NULL OR @Id_Armazem IS NULL
BEGIN
RAISERROR('Produto e Armazém são obrigatórios', 16,
1);
RETURN
END
IF @Quantidade < 0
BEGIN
RAISERROR('Quantidade não pode ser negativa', 16, 1);
RETURN
END
IF NOT EXISTS (SELECT 1 FROM Produtos WHERE
Id_produtos = @Id_Produto)
BEGIN
RAISERROR('Produto não existe', 16, 1);
RETURN;
END
IF NOT EXISTS (SELECT 1 FROM Armazens WHERE
id_armazem = @Id_Armazem)
BEGIN
RAISERROR('Armazém não existe', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM Estoque_Atual WHERE
Id_Produto = @Id_Produto AND Id_Armazem =
@Id_Armazem)
BEGIN
RAISERROR('Já existe estoque para este produto neste
armazém', 16, 1);
RETURN;
END
INSERT INTO Estoque_Atual (
id_produto, id_armazem, Quantidade, Lote,
Data_Validade
)
VALUES (
@Id_Produto, @Id_Armazem, @Quantidade, @Lote,
@Data_Validade
);
end try
begin catch
throw;
end catch
END
