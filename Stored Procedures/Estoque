Create Procedure readEstoqueByProduto_procedure
@Nome varchar
AS
Begin
SELECT e.id_estoque,p.Nome AS Nome_Produto,a.Nome AS Nome_Armazem,e.Quantidade,e.Lote,e.Data_Validade
FROM Estoque_Atual e
INNER JOIN Produtos p ON e.Id_Produto = p.Id_produtos
INNER JOIN Armazens a ON e.Id_Armazem = a.Id_Armazem
Where  UPPER(p.Nome) Like '%'+UPPER(@Nome)+'%'
ORDER BY p.Nome, a.Nome;
END
