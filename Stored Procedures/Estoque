CREATE PROCEDURE DeleteEstoque_procedure
@Id_Estoque INT
AS
BEGIN
Begin Try 
IF @Id_Estoque IS NULL
BEGIN
RAISERROR('ID do estoque é obrigatório', 16, 1);
RETURN;
END

IF NOT EXISTS (SELECT 1 FROM Estoque_Atual WHERE Id_Estoque = @Id_Estoque)
BEGIN
RAISERROR('Estoque não encontrado', 16, 1);
