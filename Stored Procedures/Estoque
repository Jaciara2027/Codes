CREATE PROCEDURE UpdateEstoque_procedure
@Id_Estoque INT,
@Quantidade DECIMAL(18,4),
@Lote VARCHAR(50) = NULL,
@Data_Validade DATE = NULL
AS
BEGIN
Begin try
IF @Id_Estoque IS NULL
BEGIN
RAISERROR('ID do estoque é obrigatório', 16, 1);
RETURN
END
IF @Quantidade < 0
BEGIN
RAISERROR('Quantidade não pode ser negativa', 16, 1);
RETURN;
END
IF NOT EXISTS (SELECT 1 FROM Estoque_Atual WHERE
id_estoque = @Id_Estoque)
BEGIN
RAISERROR('Estoque não encontrado', 16, 1);
RETURN;
END
UPDATE Estoque_Atual
SET
Quantidade = @Quantidade,
Lote = @Lote,
Data_Validade = @Data_Validade
WHERE id_estoque = @Id_Estoque;
end try
begin catch
throw;
end catch
END
