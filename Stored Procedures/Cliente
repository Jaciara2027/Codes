ALter Procedure UpdateCliente_Procedure
   @Id Int,
   @Nome Nvarchar(100),
   @Apelido Nvarchar(25),
   @Telefone Nvarchar(15),
   @Email Nvarchar(25),
   @Ativo Bit
AS
Begin
BEGIN TRY
    IF @Nome IS NULL OR @Apelido IS NULL OR @Telefone IS NULL
	BEGIN
       RAISERROR('Nome , Apelido e Telefone e obrigatorio', 16, 1);
       RETURN;
    END
	IF EXISTS (SELECT 1 FROM Clientes WHERE UPPER(@Nome)=UPPER(Nome) AND UPPER(@Apelido) =UPPER(Apelido))
	BEGIN
	   RAISERROR('Nome , Apelido e Telefone e obrigatorio', 16, 1);
       RETURN;
    END

	IF @Telefone IS NULL OR LEN(CAST(@Telefone AS VARCHAR)) < 9
    BEGIN
        RAISERROR('Telefone inválido', 16, 1);
        RETURN;
    END
	IF @Email is Null or (@Email Like '%@%' AND @Email Like '%.%')
	BEGIN 
	    RAISERROR('Verifique o seu Email',16,1);
		RETURN;
	END
  Update Clientes
  SET Nome=@Nome,Apelido=@Apelido,Telefone=@Telefone,Email=@Email,Ativo=@Ativo
  Where id_cliente=@Id
END TRY
BEGIN CATCH
THROW;
END CATCH
END
