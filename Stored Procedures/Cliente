ALTER Procedure createCliente_Procedure
   @Nome Nvarchar(100),
   @Apelido nvarchar(25),
   @Telefone varchar (15),
   @Email nvarchar(25)
AS
BEGIN 
BEGIN TRY
    IF @Nome IS NULL OR @Apelido IS NULL OR @Telefone IS NULL
	BEGIN
       RAISERROR('Nome , Apelido e Telefone e obrigatorio', 16, 1);
       RETURN;
    END
	IF @Telefone IS NULL OR LEN(CAST(@Telefone AS VARCHAR)) < 9
    BEGIN
        RAISERROR('Telefone inválido', 16, 1);
        RETURN;
    END
	IF @Email IS NULL OR  (@Email Like '%@%' AND @Email Like '%.%')
	BEGIN 
	    RAISERROR('Verifique o seu Email',16,1);
		RETURN;
	END
    INSERT INTO Clientes (Nome,Apelido,Telefone,Email)
    VALUES (@Nome,@Apelido,@Telefone,@Email)
END TRY
BEGIN CATCH
THROW;
END CATCH
END 
