ALTER Procedure createArmazem_procedure
  @Nome Nvarchar(100),
  @Endereco Text,
  @Responsavel Varchar(100)
AS
Begin
BEGIN TRY 
    IF @Nome IS NULL OR @Endereco IS NULL
    BEGIN
       RAISERROR('O Nome e o endereco do armazem sao obrigatorios',16,1);
	   RETURN;
	END
    IF EXISTS (SELECT 1 FROM Armazens WHERE Nome=@Nome)
    BEGIN 
        RAISERROR('Ja existe um Armazem com esse nome',16,1);
	    RETURN;
    END 
    INSERT INTO Armazens(Nome,Endereco,Responsavel)
   VALUES(@Nome,@Endereco,@Responsavel)
END TRY
BEGIN CATCH
THROW;
END CATCH
END
