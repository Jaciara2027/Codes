ALTER procedure readArmazensByName
@Nome Varchar(50)
As
BEGIN
BEGIN TRY 
    IF NOT EXISTS (SELECT 1 FROM Armazens WHERE  UPPER(Nome) Like '%'+UPPER(@Nome)+'%')
	BEGIN
       RAISERROR('Armazem  não encontrado', 16, 1);
       RETURN;
    END
  SELECT * from Armazens where UPPER(Nome) Like '%'+UPPER(@Nome)+'%'
END TRY
BEGIN CATCH
THROW;
END CATCH
END
