ALTER Procedure ReadArmazensById_procedure
   @Id Int
As 
Begin
Begin try
    IF NOT EXISTS (SELECT 1 FROM Armazens WHERE id_armazem = @Id)
	BEGIN
       RAISERROR('Armazem  não encontrado', 16, 1);
       RETURN;
    END
  Select * From Armazens
  Where id_armazem=@Id;
End try
BEGIN CATCH
THROW;
END CATCH
END
