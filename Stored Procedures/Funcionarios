CREATE PROCEDURE ReadFuncionarios_procedure
AS
BEGIN
    SELECT 
        Id,
        Name,
        Apelido,
        Idade,
        Cargo,
        Telefone,
        Endereco,
        Salario,
        Ativo
    FROM Funcionarios
    ORDER BY Name, Apelido;
END
GO

