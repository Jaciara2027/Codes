Alter PROCEDURE CreateMovimentoItem_procedure
    @Id_Movimento INT,
    @Id_Produto INT,
    @Quantidade DECIMAL(18,4),
    @Custo_Unitario DECIMAL(18,4) = 0,
    @Custo_Unitario_Venda DECIMAL(18,4) = 0
AS
BEGIN
BEGIN TRY
    IF @Id_Movimento IS NULL
    BEGIN
        RAISERROR('ID do movimento é obrigatório', 16, 1);
        RETURN
    END

    IF NOT EXISTS (SELECT 1 FROM Movimentos WHERE id_movimento = @Id_Movimento)
    BEGIN
        RAISERROR('Movimento não encontrado', 16, 1);
        RETURN
    END
    IF EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento AND Estado != 'pendente')
    BEGIN
        RAISERROR('Apenas movimentos em rascunho podem receber itens', 16, 1);
        RETURN
    END

    IF @Id_Produto IS NULL
    BEGIN
        RAISERROR('Produto é obrigatório', 16, 1);
        RETURN
    END

    IF NOT EXISTS (SELECT 1 FROM Produtos WHERE Id_produtos = @Id_Produto)
    BEGIN
        RAISERROR('Produto não existe', 16, 1);
        RETURN
    END

    IF @Quantidade <= 0
    BEGIN
        RAISERROR('Quantidade deve ser maior que zero', 16, 1);
        RETURN
    END

    INSERT INTO Movimentos_itens (
        Id_Movimento, Id_Produto, Quantidade,
        Custo_Unitario, Custo_Unitario_venda
    )
    VALUES (
        @Id_Movimento, @Id_Produto, @Quantidade,
        @Custo_Unitario, @Custo_Unitario_Venda
    )
END TRY
BEGIN CATCH
THROW;
END CATCH
END
