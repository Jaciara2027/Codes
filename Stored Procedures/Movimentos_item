Alter PROCEDURE UpdateMovimentoItem_procedure
    @Id_Item_Movimento Int,
    @Id_Produto INT,
    @Quantidade DECIMAL(18,4),
    @Custo_Unitario DECIMAL(18,4) = NULL,
    @Custo_Unitario_Venda DECIMAL(18,4) = NULL
AS
BEGIN
BEGIN TRY
    IF @Id_Item_Movimento IS NULL
    BEGIN
        RAISERROR('ID do item é obrigatório', 16, 1);
        RETURN
    END

    IF NOT EXISTS (SELECT 1 FROM Movimentos_itens WHERE id_Item_movimento = @Id_Item_Movimento)
    BEGIN
        RAISERROR('Item não encontrado', 16, 1);
        RETURN
    END

    -- Verifica se o movimento é rascunho
    IF EXISTS (SELECT 1 FROM Movimentos_itens mi
        INNER JOIN Movimentos m ON mi.id_movimento = m.id_movimento
        WHERE mi.id_Item_movimento = @Id_Item_Movimento AND m.Estado != 'pendente'
    )
    BEGIN
        RAISERROR('Apenas itens de movimentos em rascunho podem ser alterados', 16, 1);
        RETURN;
    END

    IF @Id_Produto IS NULL
    BEGIN
        RAISERROR('Produto é obrigatório', 16, 1);
        RETURN;
    END

    IF NOT EXISTS (SELECT 1 FROM Produtos WHERE Id_produtos = @Id_Produto)
    BEGIN
        RAISERROR('Produto não existe', 16, 1);
        RETURN
    END

    IF @Quantidade <= 0
    BEGIN
        RAISERROR('Quantidade deve ser maior que zero', 16, 1);
        RETURN;
    END

    -- 2. Atualizar
    UPDATE Movimentos_itens
    SET 
        Id_Produto = @Id_Produto,
        Quantidade = @Quantidade,
        Custo_Unitario = @Custo_Unitario,
        Custo_Unitario_venda = @Custo_Unitario_Venda
    WHERE Id_Item_Movimento = @Id_Item_Movimento;
END TRY
BEGIN CATCH
THROW;
END CATCH
END 

