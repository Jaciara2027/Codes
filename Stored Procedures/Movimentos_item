CREATE PROCEDURE readMovimentoItensByArmazem_procedure
    @Armazem varchar(100)
AS
BEGIN
    SELECT mi.Id_Item_Movimento,mi.Id_Movimento,p.Nome AS Nome_Produto,mi.Quantidade,mi.Custo_Unitario,mi.Custo_Unitario_venda
    FROM Movimentos_itens mi
    INNER JOIN Produtos p ON mi.Id_Produto = p.Id_produtos
	inner join Movimentos m ON mi.id_movimento= m.id_movimento
	inner join Armazens 
    WHERE ao.Nome = @Armazem OR ad.Nome=@Armazem
    ORDER BY mi.Id_Item_Movimento;
END
