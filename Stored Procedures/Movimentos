CREATE PROCEDURE ReadMovimentos_procedure
AS
BEGIN
    SELECT m.Id_Movimento,m.Tipo,m.Data_Hora,m.Id_Armazem_Origem,ao.Nome AS Nome_Armazem_Origem,m.Id_Armazem_Destino,
        ad.Nome AS Nome_Armazem_Destino,m.Id_Cliente,c.Nome AS Nome_Cliente,m.Observacao,m.Estado
    FROM Movimentos m
    LEFT JOIN Armazens ao ON m.Id_Armazem_Origem = ao.Id_Armazem
    LEFT JOIN Armazens ad ON m.Id_Armazem_Destino = ad.Id_Armazem
    LEFT JOIN Clientes c ON m.Id_Cliente = c.Id_Cliente
    ORDER BY m.Data_Hora DESC;
END
