Alter PROCEDURE CreateMovimento_procedure
@Tipo VARCHAR(20),
@Id_Armazem_Origem INT = NULL,
@Id_Armazem_Destino INT = NULL,
@Id_Cliente INT = NULL,
@Observacao TEXT = NULL,
@Status VARCHAR(20) = 'rascunho'
AS
BEGIN
Begin try
IF @Tipo IS NULL OR Lower(@Tipo)NOT IN
('entrada','saida','transferencia','ajuste')
BEGIN
RAISERROR('Tipo de movimento inválido', 16, 1);
RETURN
END
IF Lower(@Status) NOT IN ('pendente','confirmado','cancelado')
BEGIN
RAISERROR('Status inválido', 16, 1);
RETURN;
END
IF Lower(@Tipo) = 'entrada'AND @Id_Armazem_Destino IS NULL
BEGIN
RAISERROR('Armazém destino é obrigatório para
entrada', 16, 1);
RETURN;
END
IF Lower(@Tipo) ='saida' AND @Id_Armazem_Origem IS NULL
BEGIN
RAISERROR('Armazém origem é obrigatório para saída',
16, 1);
RETURN
END
IF Lower(@Tipo) = 'transferencia' AND (@Id_Armazem_Origem IS
NULL OR @Id_Armazem_Destino IS NULL)
BEGIN
RAISERROR('Armazém origem e destino são obrigatórios
para transferência', 16, 1);
RETURN
END
IF @Id_Armazem_Origem IS NOT NULL AND NOT EXISTS
(SELECT 1 FROM Armazens WHERE id_armazem =
@Id_Armazem_Origem)
BEGIN
RAISERROR('Armazém origem não existe', 16, 1);
RETURN
END
IF @Id_Armazem_Destino IS NOT NULL AND NOT
EXISTS (SELECT 1 FROM Armazens WHERE id_armazem
= @Id_Armazem_Destino)
BEGIN
RAISERROR('Armazém destino não existe', 16, 1);
RETURN
END
IF Not Exists (Select 1 From Clientes where id_cliente = @Id_Cliente)
Begin
Raiserror('Cliente não existe',16,1);
Return
END
INSERT INTO Movimentos (Tipo, Data_Hora, id_armazem_origem,
id_armazem_destino,
id_cliente, Observacao, Estado
)
VALUES (
@Tipo, GETDATE(), @Id_Armazem_Origem,
@Id_Armazem_Destino,
@Id_Cliente, @Observacao, @Status
)
end try
begin catch
throw;
end catch
END
