CREATE PROCEDURE DeleteMovimento_procedure
    @Id_Movimento INT
AS
BEGIN
BEGIN TRY
    IF @Id_Movimento IS NULL
    BEGIN
        RAISERROR('ID do movimento é obrigatório', 16, 1);
        RETURN;
    END

    IF NOT EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento)
    BEGIN
        RAISERROR('Movimento não encontrado', 16, 1);
        RETURN;
    END
    IF EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento AND Estado != 'pendente')
    BEGIN
        RAISERROR('Apenas movimentos em rascunho podem ser deletados', 16, 1);
        RETURN;
    END
    DELETE FROM Movimentos_itens WHERE Id_Movimento = @Id_Movimento;
    DELETE FROM Movimentos WHERE Id_Movimento = @Id_Movimento;
END TRY
BEGIN CATCH
THROW;
END CATCH
END
GO

CREATE PROCEDURE ConfirmarMovimento_procedure
    @Id_Movimento INT
AS
BEGIN
BEGIN TRY
    IF NOT EXISTS (SELECT 1 FROM Movimentos WHERE id_movimento = @Id_Movimento)
    BEGIN
        RAISERROR('Movimento não encontrado', 16, 1);
        RETURN;
    END
    IF EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento AND UPPER(Estado) =UPPER( 'confirmado'))
    BEGIN
        RAISERROR('Movimento já está confirmado', 16, 1);
        RETURN;
    END

    UPDATE Movimentos 
    SET Estado ='confirmado'
    WHERE Id_Movimento = @Id_Movimento;

    --Atualiza estoque 
    DECLARE @Tipo VARCHAR(20);
    DECLARE @Id_Armazem_Origem INT;
    DECLARE @Id_Armazem_Destino INT;

    SELECT @Tipo = Tipo, @Id_Armazem_Origem = Id_Armazem_Origem, @Id_Armazem_Destino = Id_Armazem_Destino
    FROM Movimentos WHERE Id_Movimento = @Id_Movimento;

    -- Entrada:soma no destino
    IF @Tipo = 'entrada'
    BEGIN
        UPDATE e
        SET e.Quantidade = e.Quantidade + mi.Quantidade
        FROM Estoque_Atual e
        INNER JOIN Movimentos_itens mi ON e.Id_Produto = mi.Id_Produto
        WHERE e.Id_Armazem = @Id_Armazem_Destino
        AND mi.Id_Movimento = @Id_Movimento;
    END

    -- Saída:subtrai da origem
    IF @Tipo = 'saida'
    BEGIN
        UPDATE e
        SET e.Quantidade = e.Quantidade - mi.Quantidade
        FROM Estoque_Atual e
        INNER JOIN Movimentos_itens mi ON e.Id_Produto = mi.Id_Produto
        WHERE e.Id_Armazem = @Id_Armazem_Origem
        AND mi.Id_Movimento = @Id_Movimento;
    END

    -- Transferência: subtrai origem e soma destino
    IF @Tipo = 'transferencia'
    BEGIN
        UPDATE e
        SET e.Quantidade = e.Quantidade - mi.Quantidade
        FROM Estoque_Atual e
        INNER JOIN Movimentos_itens mi ON e.Id_Produto = mi.Id_Produto
        WHERE e.Id_Armazem = @Id_Armazem_Origem
        AND mi.Id_Movimento = @Id_Movimento;

        UPDATE e
        SET e.Quantidade = e.Quantidade + mi.Quantidade
        FROM Estoque_Atual e
        INNER JOIN Movimentos_itens mi ON e.Id_Produto = mi.Id_Produto
        WHERE e.Id_Armazem = @Id_Armazem_Destino
        AND mi.Id_Movimento = @Id_Movimento;
    END
END TRY
BEGIN CATCH
THROW;
END CATCH
END
GO

CREATE PROCEDURE CancelarMovimento_procedure
    @Id_Movimento INT
AS
BEGIN
BEGIN TRY
    IF NOT EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento)
    BEGIN
        RAISERROR('Movimento não encontrado', 16, 1);
        RETURN;
    END
    IF EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento AND Estado = 'cancelado')
    BEGIN
        RAISERROR('Movimento já está cancelado', 16, 1);
        RETURN;
    END

    IF EXISTS (SELECT 1 FROM Movimentos WHERE Id_Movimento = @Id_Movimento AND Estado = 'confirmado')
    BEGIN
        DECLARE @Tipo VARCHAR(20);
        DECLARE @Id_Armazem_Origem INT;
        DECLARE @Id_Armazem_Destino INT;

        SELECT @Tipo = Tipo, @Id_Armazem_Origem = id_armazem_origem, @Id_Armazem_Destino = id_armazem_destino
        FROM Movimentos WHERE id_movimento = @Id_Movimento;

        -- subtrai do destino
        IF @Tipo = 'entrada'
        BEGIN
            UPDATE e
            SET e.Quantidade = e.Quantidade - mi.Quantidade
            FROM Estoque_Atual e
            INNER JOIN Movimentos_itens mi ON e.Id_Produto = mi.Id_Produto
            WHERE e.Id_Armazem = @Id_Armazem_Destino
            AND mi.Id_Movimento = @Id_Movimento;
        END

        -- soma na origem
        IF @Tipo = 'saida'
        BEGIN
            UPDATE e
            SET e.Quantidade = e.Quantidade + mi.Quantidade
            FROM Estoque_Atual e
            INNER JOIN Movimentos_itens mi ON e.id_produto = mi.id_produto
            WHERE e.id_armazem = @Id_Armazem_Origem
            AND mi.id_movimento = @Id_Movimento;
        END

        -- soma origem, subtrai destino
        IF @Tipo = 'transferencia'
        BEGIN
            UPDATE e
            SET e.Quantidade = e.Quantidade + mi.Quantidade
            FROM Estoque_Atual e
            INNER JOIN Movimentos_itens mi ON e.id_produto = mi.id_produto
            WHERE e.id_armazem = @Id_Armazem_Origem
            AND mi.id_movimento = @Id_Movimento;

            UPDATE e
            SET e.Quantidade = e.Quantidade - mi.Quantidade
            FROM Estoque_Atual e
            INNER JOIN Movimentos_itens mi ON e.id_produto = mi.id_produto
            WHERE e.id_armazem = @Id_Armazem_Destino
            AND mi.id_movimento = @Id_Movimento;
        END
    END

    UPDATE Movimentos SET Estado = 'cancelado' WHERE id_movimento = @Id_Movimento;
END TRY
BEGIN CATCH
THROW;
END CATCH
END
