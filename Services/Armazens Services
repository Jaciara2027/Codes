using Microsoft.Data.SqlClient;
using System.Data;
using Dapper;

namespace StockApi.Services.Armazens
{
    public class ArmazensService : IArmazens
    {
        private readonly IConfiguration _configuration;
        public ArmazensService(IConfiguration configuration)
        {
            _configuration = configuration;
        }
        private SqlConnection Connection
        {
            get
            {
                return new SqlConnection(_configuration.GetConnectionString("DefaultConnection"));
            }
        }

        public IEnumerable<dynamic> ObterTodos()
        {
            using var connection = Connection;
            return connection.Query("readArmazens_procedure", commandType: CommandType.StoredProcedure);
        }
        public dynamic? ObterArmazem(int id)
        {
            using var connection = Connection;
            try
            {
                return connection.Query("ReadArmazensById_procedure", new { Id = id }, commandType: CommandType.StoredProcedure);
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public dynamic? ObterArmazemByName(string nome)
        {
            using var connction = Connection;
            try
            {
                return Connection.Query("readArmazensByName", new { Nome = nome }, commandType: CommandType.StoredProcedure);
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string CriarArmazens(string nome, string endereco, string responsavel)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("createArmazem_procedure", new { Nome = nome, Endereco = endereco, Responsavel = responsavel }, commandType: CommandType.StoredProcedure);
                return "Armazem criado com sucesso";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string Update(int id, string nome, string endereco, string responsavel)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("UpdateArmazem_procedure", new { Id = id, Nome = nome, Endereco = endereco, Responsavel = responsavel }, commandType: CommandType.StoredProcedure);
                return "Atualizado com sucesso";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string Delete(int id)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("DeleteArmazem_procedure", new { Id = id }, commandType: CommandType.StoredProcedure);
                return "Eliminado com sucesso ";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }
}
