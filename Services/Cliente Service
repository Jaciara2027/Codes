using Dapper;
using Microsoft.AspNetCore.Http.HttpResults;
using Microsoft.Data.SqlClient;
using Microsoft.IdentityModel.Tokens;
using StockApi.Models.Stock;
using System.Data;
using System.Net.Http.Headers;
using static Microsoft.EntityFrameworkCore.DbLoggerCategory.Database;

namespace StockApi.Services
{
    public class ClienteService: ICliente
    {
        private readonly IConfiguration _configuration;
        public ClienteService(IConfiguration configuration)
        {
            _configuration = configuration;
        }
        private SqlConnection Connection
        {
            get
            {
                return new SqlConnection(_configuration.GetConnectionString("DefaultConnection"));
            }
        }

        public IEnumerable<dynamic> ObterTodos()
        {
            using var connection = Connection;
            return connection.Query("readClientes_Procedure", commandType:CommandType.StoredProcedure);
        }
        public dynamic? ObterCliente(int id)
        {
            using var connection = Connection;
            try
            {
                return connection.Query("ReadClienteById_Procedure", new { Id = id }, commandType: CommandType.StoredProcedure);
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public dynamic? ObterClienteByName(string nome)
        {
            using var connection = Connection;
            try
            {
                return connection.Query("readClientebyName_procedure", new { Nome = nome }, commandType: CommandType.StoredProcedure);
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string Criarcliente(string nome, string apelido, string telefone, string email, bool ativo)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("createCliente_Procedure", new
                {
                    Nome = nome,
                    Apelido = apelido,
                    Telefone = telefone,
                    Email = email,
                    Ativo = ativo
                }, commandType: CommandType.StoredProcedure);
                return "Movimento criado com sucesso";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string Update(int id, string nome, string apelido, string telefone, string email, bool ativo)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("UpdateCliente_Procedure", new
                {
                    Nome = nome,
                    Apelido = apelido,
                    Telefone = telefone,
                    Email = email,
                    Ativo = ativo
                }, commandType: CommandType.StoredProcedure);
                return "Movimento criado com sucesso";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
        public string Delete(int id)
        {
            using var connection = Connection;
            try
            {
                var resultado = connection.Execute("DeleteCliente_Procedure", new { Id = id }, commandType: CommandType.StoredProcedure);
                return "Apagado com sucesso";
            }
            catch (Exception ex)
            {
                return ex.Message;
            }

        }
    }
}
